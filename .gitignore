# WiseChoice 项目忽略文件

# 系统文件
.DS_Store
Thumbs.db

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
*.tmp
*.log

# 打包文件
*.crx
*.pem
*.zip

# Node modules (如果将来添加构建工具)
node_modules/

# 用户数据（仅供开发测试）
user-data/

# Python 相关（重要：Chrome 扩展不允许下划线开头的文件夹）
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Secrets and local env (never commit API keys)
.env
.env.local
.env.development
.env.production
# Optional: commit `.env.example` with placeholder names only

# Runtime logs that may contain product/search text
analysis_log.json


